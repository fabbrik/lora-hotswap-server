<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <!-- In-process HTTP host for the endpoint tests: the real route handlers and
         problem-details mapping, with no socket bound. Pinned to the installed
         ASP.NET Core runtime. -->
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Committed offline regression fixtures, copied next to the test binary so
         AdapterContentReaderTests can read them without network or the gitignored
         /adapters/ directory. -->
    <None Include="fixtures\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>fixtures\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\LoraHotswap.Core\LoraHotswap.Core.csproj" />
    <ProjectReference Include="..\..\src\LoraHotswap.Core.Ports\LoraHotswap.Core.Ports.csproj" />
    <ProjectReference Include="..\..\src\LoraHotswap.Infrastructure\LoraHotswap.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\LoraHotswap.Api\LoraHotswap.Api.csproj" />
    <!-- Story 2.8's comparison tool. The suite never runs the published comparison:
         it is a tool, not a test. What is covered here, against deliberately tiny
         workloads, is the set of claims the table rests on (every figure comes from
         a response body; a rejection publishes nothing; the resident zero is
         labelled rather than blanked). -->
    <ProjectReference Include="..\..\tools\compare\LoraHotswap.Compare.csproj" />
    <!-- Story 3.2's capture tool. The suite never runs the published capture: it loads a
         real base model and generates real text. What is covered here, against the
         deterministic fake, is what the published demonstration rests on (an answer is
         quoted exactly as the response carried it; a rejection publishes nothing; absent
         assets refuse with a reason). -->
    <ProjectReference Include="..\..\tools\capture\LoraHotswap.Capture.csproj" />
  </ItemGroup>

</Project>
