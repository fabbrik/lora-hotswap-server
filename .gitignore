# Build output
bin/
obj/
publish/
artifacts/
TestResults/

# IDE / tooling
.vs/
.idea/
*.user
*.suo

# OS
.DS_Store

# Downloaded model + adapter artifacts (tools/acquire/acquire.py populates this).
# Anchored so a source directory named "adapters" anywhere else stays tracked --
# in a ports-and-adapters codebase that name is very likely to recur.
/adapters/
/models/

# uv scratch for the acquisition tool
tools/acquire/.venv/
tools/acquire/__pycache__/
tools/acquire/.pytest_cache/

# uv scratch for the conversion tool
tools/convert/.venv/
tools/convert/__pycache__/
tools/convert/.pytest_cache/
# Vendored llama.cpp converter (obtained at the pinned converter.lock.json
# revision by convert.py). Tooling is never committed; only the lock is.
tools/convert/vendor/
.DS_Store
